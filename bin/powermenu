#!/bin/bash

set -e

# Ask before acting; "No" is listed first so a stray Enter cancels.
confirm() {
    answer=$(printf '%s\n' "No" "Yes" \
        | wofi --dmenu --prompt "$1?" --width 260 --height 230 --cache-file /dev/null) || return 1
    [[ "$answer" == "Yes" ]]
}

choice=$(printf '%s\n' \
    "󰌾  Lock" \
    "󰗽  Logout" \
    "󰒲  Suspend" \
    "󰜉  Reboot" \
    "󰐥  Shutdown" \
    | wofi --dmenu --prompt "Power" --width 260 --height 340 --cache-file /dev/null)

case "$choice" in
    *Lock)     hyprlock ;;
    *Logout)   confirm "Logout" && hyprctl dispatch 'hl.dsp.exit()' ;;
    *Suspend)  systemctl suspend ;;
    *Reboot)   systemctl reboot ;;
    *Shutdown) systemctl poweroff ;;
esac
