#!/bin/bash

set -e

choice=$(printf '%s\n' \
    "󰌾  Lock" \
    "󰗽  Logout" \
    "󰒲  Suspend" \
    "󰜉  Reboot" \
    "󰐥  Shutdown" \
    | wofi --dmenu --prompt "Power" --width 260 --height 280 --cache-file /dev/null)

case "$choice" in
    *Lock)     hyprlock ;;
    *Logout)   hyprctl dispatch 'hl.dsp.exit()' ;;
    *Suspend)  systemctl suspend ;;
    *Reboot)   systemctl reboot ;;
    *Shutdown) systemctl poweroff ;;
esac
